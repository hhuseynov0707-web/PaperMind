# Groq API açarı — https://console.groq.com/keys səhifəsindən götür
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Crossref/DOAJ «nəzakətli hovuz» üçün əlaqə e-poçtu (boş qala bilər)
CONTACT_EMAIL=

# PostgreSQL (docker compose bunları oxuyur)
POSTGRES_USER=elmradari
POSTGRES_PASSWORD=elmradari
POSTGRES_DB=elmradari

# ---------- Yalnız ictimai deploy üçün (docker-compose.prod.yml) ----------
# Domen adı — Caddy sertifikatı bunun üçün alır
DOMAIN=papermind.example.com

# Yazma endpoint-lərinin açarı. Yarat:  openssl rand -hex 32
# n8n workflow-larında X-API-Key başlığı kimi göndərilir.
ADMIN_API_KEY=

# Limitlər (boş qalsa default-lar işləyir)
ASK_RATE_LIMIT=20        # IP üzrə saatlıq LLM sualı
ASK_DAILY_BUDGET=500     # bütün istifadəçilər üçün günlük LLM tavanı
SEARCH_RATE_LIMIT=120    # IP üzrə saatlıq semantik axtarış
