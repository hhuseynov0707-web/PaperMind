# Groq API açarı — https://console.groq.com/keys səhifəsindən götür
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Struktur çıxarış (§7) üçün AYRICA, kiçik model.
# Səbəb ölçülüb: 70B ilə 300 məqalədən yalnız 11-i alındı, qalanı rate limit-ə
# dirəndi. Çıxarış minlərlə məqalə üçün təkrarlanan mexaniki işdir və cavab
# keyfiyyəti qədər kritik deyil.
EXTRACT_MODEL=llama-3.1-8b-instant

# Crossref/DOAJ «nəzakətli hovuz» üçün əlaqə e-poçtu (boş qala bilər)
CONTACT_EMAIL=

# PostgreSQL (docker compose bunları oxuyur)
POSTGRES_USER=elmradari
POSTGRES_PASSWORD=elmradari
POSTGRES_DB=elmradari

# ---------- Retrieval ----------
# "vector" | "lexical" | "hybrid"
# ÖLÇÜLDÜ, "vector" SEÇİLDİ: hibridin təsiri az -3%, en +2%, ru +2% → orta
# +0.3%, yəni səs-küy. Kod saxlanılır, rejim ölçmə fayda göstərənə qədər
# dəyişmir. Ölçmək üçün: scripts/benchmark.py --compare-retrieval
RETRIEVAL_MODE=vector

# ---------- Provider-lər (§18) ----------
# Biznes məntiqi provider adını bilmir; dəyişdirmək üçün kod redaktəsi lazım deyil.
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=fastembed

# Rerank BOŞ = sönülü. ÖLÇÜLDÜ və RƏDD EDİLDİ:
#   gecikmə  61 ms → 12 928 ms  (212 dəfə)
#   P@10     az +7%, en -5%, ru 0  → xalis ~+0.7%, yəni səs-küy
#   yaddaş   backend ~700 MB → 2.99 GB (model 1.13 GB)
#   4 GB-lıq serverdə (Hetzner CX22) stack ilə birlikdə SIĞMIR.
# Daha güclü serverdə yenidən yoxlamaq üçün:
#   scripts/benchmark.py --compare-rerank --sample 8 --field-limit 20
RERANK_PROVIDER=
RERANK_MODEL=BAAI/bge-reranker-base

# ---------- Yalnız ictimai deploy üçün (docker-compose.prod.yml) ----------
# Domen adı — Caddy sertifikatı bunun üçün alır
DOMAIN=papermind.example.com

# Yazma endpoint-lərinin açarı. Yarat:  openssl rand -hex 32
# n8n workflow-larında X-API-Key başlığı kimi göndərilir.
ADMIN_API_KEY=

# İctimai rejim: yazma endpoint-ləri açar tələb edir, limitlər işə düşür
PUBLIC_MODE=false
# Reverse proxy (Caddy/nginx) arxasındasa X-Forwarded-For oxunsun
TRUST_PROXY=false

# Limitlər (boş qalsa default-lar işləyir)
ASK_RATE_LIMIT=20            # IP üzrə saatlıq LLM sualı
ASK_DAILY_BUDGET=500         # bütün istifadəçilər üçün günlük LLM tavanı
SEARCH_RATE_LIMIT=120        # IP üzrə saatlıq semantik axtarış
TRANSLATE_DAILY_BUDGET=2000  # az/ru axtarış tərcüməsi də LLM çağırışıdır
