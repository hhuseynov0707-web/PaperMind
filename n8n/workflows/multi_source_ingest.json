{
  "id": "W4multiSourceIng",
  "name": "W4 - multi_source_ingest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 10,
              "triggerAtMinute": 30
            }
          ]
        }
      },
      "id": "a4000000-0000-0000-0000-000000000001",
      "name": "Hər gün 10:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// arXiv-dən əlavə güvənilir mənbələr. Hər biri ayrıca item olur ki,\n// biri xəta versə digəri dayanmasın (onError: continue).\nreturn [\n  { json: { source: 'crossref', days: 7, limit_per_field: 60 } },\n  { json: { source: 'doaj',     days: 30, limit_per_field: 60 } },\n];"
      },
      "id": "a4000000-0000-0000-0000-000000000002",
      "name": "Mənbə siyahısı",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/ingest/pull",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 600000
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ADMIN_API_KEY || '' }}"
            }
          ]
        }
      },
      "id": "a4000000-0000-0000-0000-000000000003",
      "name": "Mənbədən yığ (dedup backend-də)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Yekun hesabat — icra tarixçəsində oxunaqlı görünsün\nconst rows = items.map((i) => i.json);\nconst sum = (k) => rows.reduce((a, r) => a + (r[k] || 0), 0);\nreturn [{ json: {\n  sources: rows.map((r) => r.source).join(', '),\n  fetched: sum('fetched'),\n  inserted: sum('inserted'),\n  skipped: sum('skipped'),\n  merged: sum('merged'),\n  note: 'merged = eyni iş başqa mənbədə tapılıb, təkrar sətir yaradılmadı',\n} }];"
      },
      "id": "a4000000-0000-0000-0000-000000000004",
      "name": "Yekun",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Hər gün 10:30": {
      "main": [
        [
          {
            "node": "Mənbə siyahısı",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mənbə siyahısı": {
      "main": [
        [
          {
            "node": "Mənbədən yığ (dedup backend-də)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mənbədən yığ (dedup backend-də)": {
      "main": [
        [
          {
            "node": "Yekun",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "W3errorHandler01"
  },
  "pinData": {}
}
