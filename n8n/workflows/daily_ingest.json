      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// arXiv Atom feed-ini backend-in PaperIn formatına çevirir\nconst root = $json.data && $json.data.feed ? $json.data : $json;\nconst feed = root.feed || {};\nlet entries = feed.entry || [];\nif (!Array.isArray(entries)) entries = [entries];\n\nconst papers = entries.map((e) => {\n  const absUrl = typeof e.id === 'string' ? e.id : (e.id && e.id._) || '';\n  const rawId = absUrl.split('/abs/')[1] || '';\n  const arxivId = rawId.replace(/v\\d+$/, '');\n\n  let cats = e.category || [];\n  if (!Array.isArray(cats)) cats = [cats];\n  const catTerms = cats\n    .map((c) => (c && (c.term || (c.$ && c.$.term))) || null)\n    .filter(Boolean);\n\n  let auths = e.author || [];\n  if (!Array.isArray(auths)) auths = [auths];\n\n  const primaryNode = e['arxiv:primary_category'];\n  const primary =\n    (primaryNode && (primaryNode.term || (primaryNode.$ && primaryNode.$.term))) ||\n    catTerms[0] ||\n    null;\n\n  return {\n    arxiv_id: arxivId,\n    title: String(e.title || '').replace(/\\s+/g, ' ').trim(),\n    abstract: String(e.summary || '').replace(/\\s+/g, ' ').trim(),\n    primary_category: primary,\n    categories: catTerms,\n    authors: auths.map((a) => a && a.name).filter(Boolean),\n    published_at: e.published || null,\n    pdf_url: arxivId ? 'https://arxiv.org/pdf/' + arxivId : null,\n  };\n}).filter((p) => p.arxiv_id && p.abstract);\n\nreturn [{ json: { papers } }];"
      },
      "id": "a1000000-0000-0000-0000-000000000004",
      "name": "PaperIn formatına map",
