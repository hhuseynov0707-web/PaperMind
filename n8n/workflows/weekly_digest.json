{
  "id": "W2weeklyDigest01",
  "name": "W2 - weekly_digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                0
              ],
              "triggerAtHour": 20,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "b2000000-0000-0000-0000-000000000001",
      "name": "Bazar 20:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://backend:8000/api/analytics/trends?weeks=1",
        "options": {}
      },
      "id": "b2000000-0000-0000-0000-000000000002",
      "name": "Həftənin statistikası",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Trend sətirlərini LLM üçün yığcam kontekstə çevirir\nconst rows = $input.all().map((i) => i.json);\nconst lines = rows\n  .filter((r) => r && r.category)\n  .map((r) => r.week + ': ' + r.category + ' — ' + r.count + ' məqalə');\n\nconst today = new Date();\nconst monday = new Date(today);\nmonday.setDate(today.getDate() - ((today.getDay() + 6) % 7));\nconst week_start = monday.toISOString().slice(0, 10);\n\nconst context = lines.length\n  ? lines.join('\\n')\n  : 'Bu həftə yeni məqalə qeydə alınmayıb.';\n\nreturn [{ json: { week_start, context } }];"
      },
      "id": "b2000000-0000-0000-0000-000000000003",
      "name": "Kontekst hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GROQ_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.GROQ_MODEL || 'openai/gpt-oss-120b', temperature: 0.4, max_tokens: 1200, messages: [ { role: 'system', content: 'Sən elmi məqalə trendlərini izah edən analitiksən. Cavabı Azərbaycanca, 4-6 cümləlik yığcam icmal kimi yaz. Rəqəmləri konkret göstər.' }, { role: 'user', content: 'Bu həftənin arXiv statistikası:\\n' + $json.context + '\\nBu statistikaya əsasən həftəlik icmal yaz.' } ] }) }}",
        "options": {}
      },
      "id": "b2000000-0000-0000-0000-000000000004",
      "name": "Groq icmal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Kontekst hazırla').first().json;\nconst content =\n  ($json.choices && $json.choices[0] && $json.choices[0].message && $json.choices[0].message.content) ||\n  'Icmal alınmadı';\nreturn [{ json: { week_start: prev.week_start, content } }];"
      },
      "id": "b2000000-0000-0000-0000-000000000005",
      "name": "Cavabı çıxar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/digests",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ADMIN_API_KEY || '' }}"
            }
          ]
        }
      },
      "id": "b2000000-0000-0000-0000-000000000006",
      "name": "Backend-ə yaz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
