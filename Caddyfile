# Caddy avtomatik Let's Encrypt sertifikatı alır və yeniləyir.
# DOMAIN mühit dəyişəni docker-compose.prod.yml-dən gəlir.

{$DOMAIN} {
	encode gzip zstd

	# Təhlükəsizlik başlıqları
	header {
		# 1 il. `preload` QOYULMUR: preload siyahısına düşmək birtərəfli
		# qapıdır (çıxmaq aylar çəkir), üstəlik duckdns.org paylaşılan
		# suffiksdir — öz domenimiz olanda yenidən baxılmalıdır.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"

		# İşlətmədiyimiz brauzer imkanları bağlanır. `payment` Paddle üçün
		# açıq qalır — checkout onu tələb edir.
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(self), usb=(), xr-spatial-tracking=()"

		# MƏCBURİ rejim (2026-08-20-dən). Əvvəl rapor rejimində idi.
		#
		# Keçiddən əvvəl bütün yollar sınandı və SIFIR pozuntu tapıldı:
		# beş səhifə, axtarış nəticələri, Chart.js (jsdelivr), Paddle.js və
		# checkout iframe-i (buy.paddle.com). Sonuncu ən riskli idi — CSP
		# onu bloklasaydı ödəniş tamamilə dayanardı.
		#
		# GERİ QAYTARMAQ lazım olsa: başlığın adına `-Report-Only` əlavə et
		# və `docker compose up -d --force-recreate caddy` işlət. Bir fayl
		# mount olunduğu üçün sadə `reload` KİFAYƏT ETMİR (inode dəyişir).
		#
		# Siyahıdakı kənar mənbələr (yalnız bu ikisi işlənir):
		#   cdn.jsdelivr.net  → Chart.js (trend qrafiki)
		#   *.paddle.com      → Paddle.js, checkout iframe-i və onun XHR-ləri
		#
		# `style-src 'unsafe-inline'` məcburidir: kart rəngləri və vərəqləmə
		# animasiyası JS-də `style="..."` atributu ilə verilir. Skriptlərdə
		# isə `unsafe-inline` YOXDUR — index.html-də inline <script> yoxdur.
		Content-Security-Policy `default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdn.paddle.com https://*.paddle.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.paddle.com; font-src 'self'; connect-src 'self' https://*.paddle.com; frame-src https://*.paddle.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'`

		-Server
	}

	# Yazma endpoint-ləri onsuz da açar tələb edir, amma /docs ictimai
	# deploy-da lazımsızdır — istəsən bu bloku silib açıq saxlaya bilərsən.
	@docs path /docs /redoc /openapi.json
	handle @docs {
		respond "Not found" 404
	}

	reverse_proxy backend:8000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
