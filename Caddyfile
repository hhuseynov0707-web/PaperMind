# Caddy avtomatik Let's Encrypt sertifikatı alır və yeniləyir.
# DOMAIN mühit dəyişəni docker-compose.prod.yml-dən gəlir.

{$DOMAIN} {
	encode gzip zstd

	# Təhlükəsizlik başlıqları
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Yazma endpoint-ləri onsuz da açar tələb edir, amma /docs ictimai
	# deploy-da lazımsızdır — istəsən bu bloku silib açıq saxlaya bilərsən.
	@docs path /docs /redoc /openapi.json
	handle @docs {
		respond "Not found" 404
	}

	reverse_proxy backend:8000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
